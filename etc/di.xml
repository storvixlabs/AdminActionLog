<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
        Tracked entities. First match wins, so subclasses must come before parents
        (Invoice/Shipment/Creditmemo before Order). Other modules can add entries here.
        Classes from disabled modules are simply never matched.
    -->
    <type name="StorvixLabs\AdminActionLog\Model\EntityRegistry">
        <arguments>
            <argument name="entities" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Framework\App\Config\Value</item>
                    <item name="label" xsi:type="string">Configuration</item>
                    <item name="title_field" xsi:type="string">path</item>
                </item>
                <item name="product" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Catalog\Model\Product</item>
                    <item name="label" xsi:type="string">Product</item>
                    <item name="title_field" xsi:type="string">sku</item>
                    <item name="ignore" xsi:type="array">
                        <item name="has_options" xsi:type="string">has_options</item>
                        <item name="required_options" xsi:type="string">required_options</item>
                        <item name="url_path" xsi:type="string">url_path</item>
                    </item>
                </item>
                <item name="category" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Catalog\Model\Category</item>
                    <item name="label" xsi:type="string">Category</item>
                    <item name="title_field" xsi:type="string">name</item>
                    <item name="ignore" xsi:type="array">
                        <item name="children_count" xsi:type="string">children_count</item>
                    </item>
                </item>
                <item name="cms_page" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Cms\Model\Page</item>
                    <item name="label" xsi:type="string">CMS Page</item>
                    <item name="title_field" xsi:type="string">identifier</item>
                </item>
                <item name="cms_block" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Cms\Model\Block</item>
                    <item name="label" xsi:type="string">CMS Block</item>
                    <item name="title_field" xsi:type="string">identifier</item>
                </item>
                <item name="customer" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Customer\Model\Customer</item>
                    <item name="label" xsi:type="string">Customer</item>
                    <item name="title_field" xsi:type="string">email</item>
                    <item name="ignore" xsi:type="array">
                        <item name="failures_num" xsi:type="string">failures_num</item>
                        <item name="first_failure" xsi:type="string">first_failure</item>
                        <item name="lock_expires" xsi:type="string">lock_expires</item>
                        <item name="rp_token_created_at" xsi:type="string">rp_token_created_at</item>
                    </item>
                </item>
                <item name="customer_group" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Customer\Model\Group</item>
                    <item name="label" xsi:type="string">Customer Group</item>
                    <item name="title_field" xsi:type="string">customer_group_code</item>
                </item>
                <item name="cart_rule" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\SalesRule\Model\Rule</item>
                    <item name="label" xsi:type="string">Cart Price Rule</item>
                    <item name="title_field" xsi:type="string">name</item>
                    <item name="ignore" xsi:type="array">
                        <item name="times_used" xsi:type="string">times_used</item>
                    </item>
                </item>
                <item name="catalog_rule" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\CatalogRule\Model\Rule</item>
                    <item name="label" xsi:type="string">Catalog Price Rule</item>
                    <item name="title_field" xsi:type="string">name</item>
                </item>
                <item name="invoice" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Sales\Model\Order\Invoice</item>
                    <item name="label" xsi:type="string">Invoice</item>
                    <item name="title_field" xsi:type="string">increment_id</item>
                </item>
                <item name="shipment" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Sales\Model\Order\Shipment</item>
                    <item name="label" xsi:type="string">Shipment</item>
                    <item name="title_field" xsi:type="string">increment_id</item>
                </item>
                <item name="creditmemo" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Sales\Model\Order\Creditmemo</item>
                    <item name="label" xsi:type="string">Credit Memo</item>
                    <item name="title_field" xsi:type="string">increment_id</item>
                </item>
                <item name="order" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Sales\Model\Order</item>
                    <item name="label" xsi:type="string">Order</item>
                    <item name="title_field" xsi:type="string">increment_id</item>
                </item>
                <item name="admin_user" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\User\Model\User</item>
                    <item name="label" xsi:type="string">Admin User</item>
                    <item name="title_field" xsi:type="string">username</item>
                    <item name="ignore" xsi:type="array">
                        <item name="logdate" xsi:type="string">logdate</item>
                        <item name="lognum" xsi:type="string">lognum</item>
                        <item name="extra" xsi:type="string">extra</item>
                        <item name="reload_acl_flag" xsi:type="string">reload_acl_flag</item>
                        <item name="failures_num" xsi:type="string">failures_num</item>
                        <item name="first_failure" xsi:type="string">first_failure</item>
                        <item name="lock_expires" xsi:type="string">lock_expires</item>
                        <item name="modified" xsi:type="string">modified</item>
                    </item>
                </item>
                <item name="admin_role" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Authorization\Model\Role</item>
                    <item name="label" xsi:type="string">Admin Role</item>
                    <item name="title_field" xsi:type="string">role_name</item>
                </item>
                <item name="url_rewrite" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\UrlRewrite\Model\UrlRewrite</item>
                    <item name="label" xsi:type="string">URL Rewrite</item>
                    <item name="title_field" xsi:type="string">request_path</item>
                </item>
                <item name="tax_rate" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Tax\Model\Calculation\Rate</item>
                    <item name="label" xsi:type="string">Tax Rate</item>
                    <item name="title_field" xsi:type="string">code</item>
                </item>
                <item name="store_view" xsi:type="array">
                    <item name="class" xsi:type="string">Magento\Store\Model\Store</item>
                    <item name="label" xsi:type="string">Store View</item>
                    <item name="title_field" xsi:type="string">code</item>
                </item>
            </argument>
        </arguments>
    </type>

    <type name="StorvixLabs\AdminActionLog\Model\ActorResolver">
        <arguments>
            <argument name="authSession" xsi:type="object">Magento\Backend\Model\Auth\Session\Proxy</argument>
            <argument name="userContext" xsi:type="object">Magento\Authorization\Model\UserContextInterface\Proxy</argument>
        </arguments>
    </type>

    <!-- Mass "Update attributes" bypasses model saves, so it is logged separately. -->
    <type name="Magento\Catalog\Model\Product\Action">
        <plugin name="storvixlabs_actionlog_mass_update" type="StorvixLabs\AdminActionLog\Plugin\ProductMassUpdatePlugin"/>
    </type>

    <!-- Admin grid -->
    <virtualType name="StorvixLabs\AdminActionLog\Model\ResourceModel\Log\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">storvixlabs_admin_action_log</argument>
            <argument name="resourceModel" xsi:type="string">StorvixLabs\AdminActionLog\Model\ResourceModel\Log</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="storvixlabs_admin_action_log_listing_data_source" xsi:type="string">StorvixLabs\AdminActionLog\Model\ResourceModel\Log\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
